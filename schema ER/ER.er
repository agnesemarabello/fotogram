_moderazione\n}\nentity MODERATORE {\n    timestamp_moderatore\n}\nentity FOLLOWING_LIST {\n    timestamp_following\n}\n\n/* Relationships */\nrelationship LOGIN (\n    UTENTE: zero..one,\n    SESSIONE: one..one external\n)\nrelationship PUBBLICA (\n    POST: one..one,\n    UTENTE: zero..many\n)\nrelationship SEGNALA (\n    FLAG: one..one external,\n    UTENTE: zero..many\n)\nrelationship MOD_AM (\n    ADMIN: zero..many,\n    MODERAZIONE: zero..one\n)\nrelationship SEGNALATI (\n    FLAG: one..one external,\n    POST: zero..one\n)\nrelationship LIKE_POST (\n    MI_PIACE: one..one external,\n    POST: zero..many\n)\nrelationship LIKE_UTENTE (\n    MI_PIACE: one..one external,\n    UTENTE: zero..many\n)\nrelationship NOMINA (\n    MODERATORE: one..one,\n    ADMIN: zero..many\n)\nrelationship MOD_POST (\n    POST: zero..many,\n    MODERAZIONE: one..one external\n)\nrelationship MOD_MOD (\n    MODERAZIONE: zero..one,\n    MODERATORE: zero..many\n)\nrelationship SEGUACE (\n    UTENTE: zero..many,\n    FOLLOWING_LIST: one..one external\n)\nrelationship SEGUITO (\n    UTENTE: zero..many,\n    FOLLOWING_LIST: one..one external\n)\n\n/* Generalizations */\nUTENTE <= {\n    ADMIN,\n    MODERATORE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"UTENTE","_x":-314,"_y":-41,"_mag":false},{"__type":"Attribute","_id":2,"_name":"email","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":115,"_y":-85},{"__type":"Attribute","_id":3,"_name":"username","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":48,"_y":-107},{"__type":"Attribute","_id":4,"_name":"password","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":169,"_y":-63},{"__type":"Entity","_id":6,"_name":"SESSIONE","_x":-321,"_y":-473,"_mag":false},{"__type":"Relationship","_id":7,"_name":"LOGIN","_x":-317,"_y":-258},{"__type":"Participation","_id":9,"_entityId":1,"_tableId":null,"_r