    Post_id (id)\n}\nentity FLAG {\n    Motivazione (optional),\n    Timestamp_flag\n}\nentity MI_PIACE {\n    Timestamp_like\n}\nentity MODERAZIONE {\n    Timestamp_moderazione,\n    Username_moderazione\n}\nentity MODERATORE {\n    Timestamp_nomina\n}\nentity FOLLOWING_LIST {\n    Timestamp_following\n}\n\n/* Relationships */\nrelationship LOGIN (\n    UTENTE: zero..one,\n    SESSIONE: one..one external\n)\nrelationship PUBBLICA (\n    POST: one..one,\n    UTENTE: zero..many\n)\nrelationship SEGNALA (\n    FLAG: one..one external,\n    UTENTE: zero..many\n)\nrelationship MOD_AM (\n    ADMIN: zero..many,\n    MODERAZIONE: zero..one\n)\nrelationship SEGNALATI (\n    FLAG: one..one external,\n    POST: zero..one\n)\nrelationship LIKE_POST (\n    MI_PIACE: one..one external,\n    POST: zero..many\n)\nrelationship LIKE_UTENTE (\n    MI_PIACE: one..one external,\n    UTENTE: zero..many\n)\nrelationship NOMINA (\n    MODERATORE: one..one,\n    ADMIN: zero..many\n)\nrelationship MOD_POST (\n    POST: zero..many,\n    MODERAZIONE: one..one external\n)\nrelationship MOD_MOD (\n    MODERAZIONE: zero..one,\n    MODERATORE: zero..many\n)\nrelationship SEGUACE (\n    UTENTE: zero..many,\n    FOLLOWING_LIST: one..one external\n)\nrelationship SEGUITO (\n    UTENTE: zero..many,\n    FOLLOWING_LIST: one..one external\n)\n\n/* Generalizations */\nUTENTE <= {\n    ADMIN,\n    MODERATORE\n} (partial, exclusive)","sqlCode":"","itemsArray":[{"__type":"Table","_id":129,"_name":"UTENTE","_x":-314,"_y":-42,"_mag":false},{"__type":"Column","_id":138,"_name":"Username","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":0},{"__type":"Column","_id":139,"_name":"Email","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":1},{"__type":"Column","_id":140,"_name":"Password","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":2},{"__type":"Column","_id":