T {\n    Timestamp_following\n}\n\n/* Relationships */\nrelationship LOGIN (\n    UTENTE: zero..one,\n    SESSIONE: one..one external\n)\nrelationship PUBBLICA (\n    POST: one..one,\n    UTENTE: zero..many\n)\nrelationship SEGNALA (\n    FLAG: one..one external,\n    UTENTE: zero..many\n)\nrelationship MOD_AM (\n    ADMIN: zero..many,\n    MODERAZIONE: zero..one\n)\nrelationship SEGNALATI (\n    FLAG: one..one external,\n    POST: zero..one\n)\nrelationship LIKE_POST (\n    MI_PIACE: one..one external,\n    POST: zero..many\n)\nrelationship LIKE_UTENTE (\n    MI_PIACE: one..one external,\n    UTENTE: zero..many\n)\nrelationship NOMINA (\n    MODERATORE: one..one,\n    ADMIN: zero..many\n)\nrelationship MOD_POST (\n    POST: zero..many,\n    MODERAZIONE: one..one external\n)\nrelationship MOD_MOD (\n    MODERAZIONE: zero..one,\n    MODERATORE: zero..many\n)\nrelationship SEGUACE (\n    UTENTE: zero..many,\n    FOLLOWING_LIST: one..one external\n)\nrelationship SEGUITO (\n    UTENTE: zero..many,\n    FOLLOWING_LIST: one..one external\n)\n\n/* Generalizations */\nUTENTE <= {\n    ADMIN,\n    MODERATORE\n} (partial, exclusive)","sqlCode":"/* Tables */\nCREATE TABLE UTENTE (\n    Username INTEGER NOT NULL,\n    Email INTEGER NOT NULL,\n    Password INTEGER NOT NULL,\n    Immagine_profilo INTEGER NOT NULL,\n    Ruolo INTEGER NOT NULL,\n    Limitato INTEGER,\n    PRIMARY KEY (Username)\n);\nCREATE TABLE POST (\n    Post_id INTEGER NOT NULL,\n    Timestamp_post INTEGER NOT NULL,\n    Moderato INTEGER NOT NULL,\n    Testo INTEGER,\n    Flaggato INTEGER NOT NULL,\n    Image_base64 INTEGER,\n    UTENTE_Username INTEGER NOT NULL,\n    PRIMARY KEY (Post_id),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE SESSIONE (\n    UTENTE_Username INTEGER NOT NULL,\n    Access_token INTEGER NOT NULL,\n    Timestamp_inizio INTEGER NOT NULL,\n    Timestamp_fine INTEGER,\n    PRIMARY KEY (UTENTE_Username, Access_token),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE FOLLOWING_LIST (\n    UTENTE_Username INTEGER NOT NULL,\n    UTENTE_Username INTEGER NOT NULL,\n    Timestamp_following INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username, UTENTE_Username),\n    FOREIGN KEY (UTENTE_Username, UTENTE_Username) REFERENCES UTENTE (Username, Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE MODERATORE (\n    UTENTE_Username INTEGER NOT NULL,\n    Timestamp_nomina INTEGER NOT NULL,\n    ADMIN_UTENTE_Username INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (ADMIN_UTENTE_Username) REFERENCES ADMIN (UTENTE_Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE ADMIN (\n    UTENTE_Username INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE MI_PIACE (\n    UTENTE_Username INTEGER NOT NULL,\n    POST_Post_id INTEGER NOT NULL,\n    Timestamp_like INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username, POST_Post_id),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (POST_Post_id) REFERENCES POST (Post_id)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE FLAG (\n    UTENTE_Username INTEGER NOT NULL,\n    POST_Post_id INTEGER NOT NULL,\n    Motivazione INTEGER,\n    Timestamp_flag INTEGER NOT NULL,\n    PRIMARY KEY (UTENTE_Username, POST_Post_id),\n    FOREIGN KEY (UTENTE_Username) REFERENCES UTENTE (Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (POST_Post_id) REFERENCES POST (Post_id)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);\nCREATE TABLE MODERAZIONE (\n    POST_Post_id INTEGER NOT NULL,\n    Timestamp_moderazione INTEGER NOT NULL,\n    Username_moderazione INTEGER NOT NULL,\n    ADMIN_UTENTE_Username INTEGER,\n    MODERATORE_UTENTE_Username INTEGER,\n    PRIMARY KEY (POST_Post_id),\n    FOREIGN KEY (POST_Post_id) REFERENCES POST (Post_id)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (ADMIN_UTENTE_Username) REFERENCES ADMIN (UTENTE_Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION,\n    FOREIGN KEY (MODERATORE_UTENTE_Username) REFERENCES MODERATORE (UTENTE_Username)\n    ON DELETE NO ACTION\n    ON UPDATE NO ACTION\n);","itemsArray":[{"__type":"Table","_id":129,"_name":"UTENTE","_x":-314,"_y":-42,"_mag":false},{"__type":"Column","_id":138,"_name":"Username","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":0},{"__type":"Column","_id":139,"_name":"Email","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":1},{"__type":"Column","_id":140,"_name":"Password","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":2},{"__type":"Column","_id":141,"_name":"Immagine_profilo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":3},{"__type":"Column","_id":142,"_name":"Ruolo","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":129,"_tableIndex":4},{"__type":"Column","_id":143,"_name":"Limitato","_type":"integer","_identifier":false,"_unique":false,"_nullable":true,"_tableId":129,"_tableIndex":5},{"__type":"Table","_id":144,"_name":"POST","_x":-1421,"_y":261,"_mag":false},{"__type":"Column","_id":149,"_name":"Post_id","_type":"integer","_identifier":true,"_unique":false,"_nullable":false,"_tableId":144,"_tableIndex":0},{"__type":"Column","_id":150,"_name":"Timestamp_post","_type":"integer","_identifier":false,"_unique":false,"_nullable":false,"_tableId":144,"_tableIn