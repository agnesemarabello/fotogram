"_identifier":false,"_unique":false,"_nullable":true,"_tableId":191,"_tableIndex":4},"205":{"__type":"ForeignKey","_id":205,"_referencingColumnId":204,"_referencedColumnId":170}},"sqlLinearCode":"<h3>Relational logical schema</h3>UTENTE (<u  style=\"text-decoration: underline;\">Username</u>, Email, Password, Immagine_profilo, Ruolo, Limitato*)<br><br>\nPOST (<u  style=\"text-decoration: underline;\">Post_id</u>, Timestamp_post, Moderato, Testo*, Flaggato, Image_base64*, UTENTE_Username)<br><br>\nSESSIONE (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, <u  style=\"text-decoration: underline;\">Access_token</u>, Timestamp_inizio, Timestamp_fine*)<br><br>\nFOLLOWING_LIST (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, <u  style=\"text-decoration: underline;\">UTENTE_Username</u>, Timestamp_following)<br><br>\nMODERATORE (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, Timestamp_nomina, ADMIN_UTENTE_Username)<br><br>\nADMIN (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>)<br><br>\nMI_PIACE (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, <u  style=\"text-decoration: underline;\">POST_Post_id</u>, Timestamp_like)<br><br>\nFLAG (<u  style=\"text-decoration: underline;\">UTENTE_Username</u>, <u  style=\"text-decoration: underline;\">POST_Post_id</u>, Motivazione*, Timestamp_flag)<br><br>\nMODERAZIONE (<u  style=\"text-decoration: underline;\">POST_Post_id</u>, Timestamp_moderazione, Username_moderazione, ADMIN_UTENTE_Username*, MODERATORE_UTENTE_Username*)<br><br>\n\n<br><h3>Referential integrity constraints</h3>\nPOST (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>\nSESSIONE (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>\nFOLLOWING_LIST (UTENTE_Username, UTENTE_Username)  REFERENCES UTENTE  (Username, Username)<br><br>\nMODERATORE (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>MODERATORE (ADMIN_UTENTE_Username)  REFERENCES ADMIN  (UTENTE_Username)<br><br>\nADMIN (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>\nMI_PIACE (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>MI_PIACE (POST_Post_id)  REFERENCES POST  (Post_id)<br><br>\nFLAG (UTENTE_Username)  REFERENCES UTENTE  (Username)<br><br>FLAG (POST_Post_id)  REFERENCES POST  (Post_id)<br><br>\nMODERAZIONE (POST_Post_id)  REFERENCES POST  (Post_id)<br><br>MODERAZIONE (ADMIN_UTENTE_Username)  REFERENCES ADMIN  (UTENTE_Username)<br><br>MODERAZIONE (MODERATORE_UTENTE_Username)  REFERENCES MODERATORE  (UTENTE_Username)<br><br>"},"edited":true,"sceneResetToken":1750078478209,"selectedItemId":null,"oldRenamingValue":"","renamingValue":"","showRenamingInput":false,"showDataTypeOptions":false,"showReorderingMenu":false,"showExportMenu":false},"editorData":null,"showNotesDataMenu":false}